---
export interface BenchmarkData {
  name: string;
  benchmark: number;
  metric: string;
  value: string;
}

export interface Props {
  benchmarks: BenchmarkData[];
}

const { benchmarks } = Astro.props;

const maxBenchmark = Math.max(
  ...benchmarks.map((b) => b.benchmark)
);
---

<div class="benchmark-list">
  {benchmarks.map((item) => {
    const percentage = (item.benchmark / maxBenchmark) * 100;

    return (
      <div class="benchmark">
        <div class="info">
          <h3>{item.name}</h3>
          <p>{item.metric}: {item.value}</p>
        </div>

        <div class="bar-container">
          <div
            class="bar-fill"
            style={`width:${percentage}%`}
          >
            {percentage.toFixed(1)}%
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
.benchmark-list {
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.benchmark {
  display:flex;
  align-items:center;
  gap:2rem;
}

.info {
  width:200px;
}

.info h3 {
  margin:0;
}

.info p {
  margin:0.25rem 0;
}

.bar-container {
  flex:1;
  height:35px;
  background:#222;
  border-radius:8px;
  overflow:hidden;
}

.bar-fill {
  height:100%;
  background:#4caf50;
  display:flex;
  justify-content:flex-end;
  align-items:center;
  padding-right:10px;
  color:white;
  font-weight:bold;
  transition:width .5s ease;
}
</style>
