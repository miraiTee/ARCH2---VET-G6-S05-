---
// src/components/Visual6502Embed.astro
export interface Props {
  height?: string;
  maxWidth?: string;
}
const { height = "700px", maxWidth = "900px" } = Astro.props;

// The simulator wants a big canvas. Render the iframe at this "native" size,
// then scale it down (or up) with CSS to fit whatever width the wrapper has.
const nativeWidth = 1400;
const nativeHeight = 1000;
---
<div class="v6502-wrapper" style={`height: ${height}; max-width: ${maxWidth};`}>
  <iframe
    src="https://visual6502.org/sim/varm/armgl.html"
    title="ARM1 Gate-level Simulation"
    width={nativeWidth}
    height={nativeHeight}
    class="v6502-frame"
    loading="lazy"
    allowfullscreen
  />
</div>

<style>
  .v6502-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 900px;
    margin: 1.5rem auto;
    border: 1px solid #ccc;
    border-radius: 8px;
  }
  .v6502-frame {
    position: absolute;
    top: 0;
    left: 0;
    border: none;
    transform-origin: top left;
  }
</style>

<script define:vars={{ nativeWidth, nativeHeight }}>
  function scaleV6502() {
    document.querySelectorAll(".v6502-wrapper").forEach((wrapper) => {
      const el = wrapper.querySelector(".v6502-frame");
      if (!el) return;
      const scale = wrapper.clientWidth / nativeWidth;
      el.style.transform = `scale(${scale})`;
      // keep the wrapper's visible height matching the scaled iframe
      wrapper.style.height = `${nativeHeight * scale}px`;
    });
  }
  window.addEventListener("resize", scaleV6502);
  scaleV6502();
</script>
